/* ============================================================
   全局设计令牌 · shadcn/ui 体系（现代 · 中性 · 极简 · 精致）
   ============================================================ */
page {
  /* 色彩令牌 */
  --background: #FFFFFF;          /* 页面背景 */
  --foreground: #09090B;          /* 主文字 */
  --card: #FFFFFF;                /* 卡片背景 */
  --card-foreground: #09090B;
  --primary: #18181B;             /* 主操作（黑） */
  --primary-foreground: #FAFAFA;
  --secondary: #F4F4F5;           /* 次级/辅助底 */
  --secondary-foreground: #18181B;
  --muted: #F4F4F5;               /* 弱化底 */
  --muted-foreground: #71717A;    /* 弱化文字 */
  --accent: #F4F4F5;
  --accent-foreground: #18181B;
  --border: #E4E4E7;              /* 描边 */
  --input: #E4E4E7;
  --ring: #18181B;
  --destructive: #EF4444;         /* 危险/错误 */
  --destructive-foreground: #FAFAFA;
  --success: #16A34A;             /* 成功 */

  /* 圆角 */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-full: 999rpx;

  /* 阴影（柔和分层） */
  --shadow-xs: 0 1rpx 2rpx rgba(9, 9, 11, 0.04);
  --shadow-sm: 0 2rpx 8rpx rgba(9, 9, 11, 0.06);
  --shadow-md: 0 8rpx 24rpx rgba(9, 9, 11, 0.10);
  --shadow-lg: 0 16rpx 48rpx rgba(9, 9, 11, 0.16);

  background-color: var(--background);
  color: var(--foreground);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
    "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

/* 通用按钮（shadcn button 基础态） */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 44rpx;
  border-radius: var(--radius-md);
  background: var(--primary);
  color: var(--primary-foreground);
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: var(--shadow-xs);
  transition: opacity 0.15s ease, transform 0.1s ease;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-primary[disabled] {
  background: var(--secondary);
  color: var(--muted-foreground);
  box-shadow: none;
}

/* 次级按钮 */
.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 44rpx;
  border-radius: var(--radius-md);
  background: var(--secondary);
  color: var(--secondary-foreground);
  font-size: 28rpx;
  font-weight: 500;
  border: 1rpx solid var(--border);
  transition: opacity 0.15s ease;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  opacity: 0.8;
}
