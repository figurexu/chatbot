<view class="chat-page">
  <scroll-view class="msg-list" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <view id="msg-top" class="chat-head">
      <image class="head-avatar" src="/images/avatars/{{avatar}}" mode="aspectFill"></image>
      <view class="head-info">
        <view class="head-name">{{name}}</view>
        <view class="head-era">{{dynasty}}{{title ? ' · ' + title : ''}}</view>
      </view>
      <view class="voice-toggle">
        <text class="voice-toggle-label">语音</text>
        <switch checked="{{voiceEnabled}}" bindchange="onVoiceToggle" color="#A03A2B" style="transform: scale(0.7)" />
      </view>
      <view class="clear-btn" bindtap="onClear">清空</view>
    </view>

    <view
      wx:for="{{messages}}"
      wx:key="index"
      id="msg-{{index}}"
      class="row {{item.role === 'user' ? 'row-user' : 'row-assistant'}}"
    >
      <image wx:if="{{item.role !== 'user'}}" class="bubble-avatar" src="/images/avatars/{{avatar}}" mode="aspectFill"></image>
      <view class="bubble-wrap">
        <view class="bubble {{item.isError ? 'bubble-error' : ''}}">{{item.content}}</view>
        <view class="bubble-meta">
          <view class="time" wx:if="{{item.time}}">{{item.time}}</view>
          <view wx:if="{{item.role !== 'user' && voiceReady && voiceEnabled}}" class="replay-btn" data-content="{{item.content}}" bindtap="onReplay">🔊 播报</view>
        </view>
      </view>
    </view>

    <view wx:if="{{sending}}" class="row row-assistant">
      <image class="bubble-avatar" src="/images/avatars/{{avatar}}" mode="aspectFill"></image>
      <view class="bubble bubble-typing">
        <view class="dot"></view><view class="dot"></view><view class="dot"></view>
      </view>
    </view>

    <view id="msg-bottom"></view>
  </scroll-view>

  <view class="input-bar">
    <view
      class="mic-btn {{recording ? 'mic-btn-active' : ''}}"
      bindtouchstart="onRecStart"
      bindtouchend="onRecEnd"
      bindtouchmove="onRecMove"
      bindtouchcancel="onRecCancel"
      hover-class="none"
    >{{recording ? '◉' : '🎙'}}</view>
    <input
      class="input"
      value="{{input}}"
      placeholder="对{{name}}说点什么…"
      placeholder-class="input-ph"
      confirm-type="send"
      bindinput="onInput"
      bindconfirm="onSend"
      disabled="{{sending}}"
    />
    <button class="btn-primary send-btn" bindtap="onSend" disabled="{{sending || !input}}">发送</button>
  </view>

  <view wx:if="{{recording}}" class="rec-overlay">
    <view class="rec-panel">
      <view class="rec-icon">🎙</view>
      <view class="rec-text">{{recSlideCancel ? '松开手指，取消发送' : (recLiveText ? recLiveText : '正在聆听… 松开发送')}}</view>
      <view class="rec-hint">{{recSlideCancel ? '' : (recLiveText ? '（继续说吧，上滑取消）' : '（上滑取消）')}}</view>
      <view class="rec-btns">
        <view class="rec-btn rec-btn-cancel" bindtap="onRecCancel">取消</view>
        <view class="rec-btn rec-btn-send" bindtap="onRecSendTap">完成</view>
      </view>
    </view>
  </view>
</view>
