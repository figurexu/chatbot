.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #F7F3E8;
}

.msg-list {
  flex: 1;
  height: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.chat-head {
  display: flex;
  align-items: center;
  padding: 28rpx 4rpx 20rpx;
  border-bottom: 1rpx solid #E8DFC8;
}

.head-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid #D8C9A8;
  background: #EFE6D0;
}

.head-info {
  flex: 1;
  margin-left: 20rpx;
}

.head-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #33281C;
}

.head-era {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8A7A60;
}

.clear-btn {
  font-size: 26rpx;
  color: #A03A2B;
  padding: 8rpx 16rpx;
  border: 1rpx solid #D9B8A8;
  border-radius: 28rpx;
}

.row {
  display: flex;
  margin-top: 28rpx;
  align-items: flex-start;
}

.row-user {
  justify-content: flex-end;
}

.bubble-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid #D8C9A8;
  flex-shrink: 0;
  background: #EFE6D0;
  margin-right: 16rpx;
}

.bubble-wrap {
  max-width: 76%;
  display: flex;
  flex-direction: column;
}

.row-user .bubble-wrap {
  align-items: flex-end;
}

.bubble {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  line-height: 1.7;
  word-break: break-all;
  background: #FDFAF3;
  border: 1rpx solid #E8DFC8;
  color: #3A342C;
  box-shadow: 0 2rpx 8rpx rgba(60, 45, 25, 0.04);
}

.row-user .bubble {
  background: #2F2A24;
  border-color: #2F2A24;
  color: #F7EFDD;
  border-top-right-radius: 6rpx;
}

.row-assistant .bubble {
  border-top-left-radius: 6rpx;
}

.bubble-error {
  color: #A03A2B;
}

.time {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #B5A888;
}

.bubble-typing {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 6rpx;
  border-radius: 50%;
  background: #C8B893;
  animation: blink 1.2s infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 60%, 100% { opacity: 0.25; }
  30% { opacity: 1; }
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FDFAF3;
  border-top: 1rpx solid #E8DFC8;
}

.input {
  flex: 1;
  height: 80rpx;
  background: #F1EBD9;
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: #3A342C;
}

.input-ph {
  color: #B5A888;
}

.send-btn {
  margin-left: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 40rpx;
  font-size: 30rpx;
}

.send-btn[disabled] {
  background-color: #D8C4B4;
  color: #FDF9F0;
}
