/* ============================================================
   聊天页 · shadcn/ui 风格
   ============================================================ */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--background);
}

/* ===== 顶栏 ===== */
.msg-list {
  flex: 1;
  height: 0;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.chat-head {
  display: flex;
  align-items: center;
  padding: 32rpx 4rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
  background: var(--background);
}

.head-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--radius-full);
  border: 2rpx solid var(--border);
  background: var(--secondary);
  flex-shrink: 0;
}

.head-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.head-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--foreground);
  letter-spacing: 1rpx;
}

.head-era {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--muted-foreground);
}

.head-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.voice-toggle {
  display: flex;
  align-items: center;
  margin-right: 8rpx;
}

.voice-toggle-label {
  font-size: 22rpx;
  color: var(--muted-foreground);
  margin-right: 2rpx;
}

.clear-btn {
  font-size: 22rpx;
  color: var(--muted-foreground);
  padding: 10rpx 22rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-full);
  margin-left: 12rpx;
  transition: background 0.15s ease;
}

.clear-btn:active {
  background: var(--muted);
}

/* ===== 消息 ===== */
.row {
  display: flex;
  margin-top: 30rpx;
  align-items: flex-start;
}

.row-user {
  justify-content: flex-end;
}

.bubble-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: var(--radius-full);
  border: 2rpx solid var(--border);
  flex-shrink: 0;
  background: var(--secondary);
  margin-right: 16rpx;
}

.bubble-wrap {
  max-width: 76%;
  display: flex;
  flex-direction: column;
}

.row-user .bubble-wrap {
  align-items: flex-end;
}

.bubble {
  padding: 20rpx 26rpx;
  font-size: 30rpx;
  line-height: 1.7;
  word-break: break-all;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md) var(--radius-md) var(--radius-md) 8rpx;
  color: var(--foreground);
  box-shadow: var(--shadow-xs);
}

.row-user .bubble {
  background: var(--primary);
  border-color: var(--primary);
  color: var(--primary-foreground);
  border-radius: var(--radius-md) var(--radius-md) 8rpx var(--radius-md);
}

.bubble-error {
  color: var(--destructive);
  border-color: #FECACA;
  background: #FEF2F2;
}

.time {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--muted-foreground);
  opacity: 0.7;
}

.bubble-meta {
  display: flex;
  align-items: center;
}

.replay-btn {
  margin-top: 10rpx;
  margin-left: 20rpx;
  font-size: 21rpx;
  color: var(--muted-foreground);
  padding: 4rpx 18rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-full);
  background: var(--background);
  transition: background 0.15s ease, color 0.15s ease;
}

.replay-btn:active {
  background: var(--secondary);
  color: var(--secondary-foreground);
}

/* 打字中 */
.bubble-typing {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  margin: 0 5rpx;
  border-radius: 50%;
  background: var(--muted-foreground);
  opacity: 0.4;
  animation: blink 1.2s infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink {
  0%, 60%, 100% { opacity: 0.25; }
  30% { opacity: 1; }
}

/* ===== 输入栏 ===== */
.input-bar {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--background);
  border-top: 1rpx solid var(--border);
}

/* 麦克风图标（lucide 风格 SVG） */
.mic-btn {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--radius-full);
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-xs);
  transition: transform 0.1s ease, box-shadow 0.15s ease;
}

.mic-btn:active {
  transform: scale(0.94);
}

.mic-btn-active {
  background: var(--destructive);
  box-shadow: 0 0 0 10rpx rgba(239, 68, 68, 0.12);
  animation: mic-pulse 1.2s infinite;
}

@keyframes mic-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.28); }
  50% { box-shadow: 0 0 0 14rpx rgba(239, 68, 68, 0.10); }
}

.mic-img {
  width: 44rpx;
  height: 44rpx;
}

.mic-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FFF;
  border: 3rpx solid var(--destructive);
  box-sizing: border-box;
}

/* 输入框 */
.input {
  flex: 1;
  height: 80rpx;
  background: var(--secondary);
  border: 1rpx solid transparent;
  border-radius: var(--radius-full);
  padding: 0 32rpx;
  font-size: 29rpx;
  color: var(--foreground);
  transition: border-color 0.15s ease, background 0.15s ease;
}

.input:focus {
  border-color: var(--ring);
  background: var(--background);
}

.input-ph {
  color: var(--muted-foreground);
  opacity: 0.75;
}

.send-btn {
  margin-left: 16rpx;
  height: 80rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}

/* ===== 录音浮层（白卡 + 大阴影） ===== */
.rec-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(9, 9, 11, 0.5);
  backdrop-filter: blur(4rpx);
  z-index: 99;
}

.rec-panel {
  width: 480rpx;
  min-height: 420rpx;
  padding: 56rpx 40rpx 40rpx;
  border-radius: var(--radius-lg);
  background: var(--card);
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.rec-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-full);
  background: var(--secondary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.rec-img {
  width: 64rpx;
  height: 64rpx;
}

.rec-text {
  margin-top: 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--foreground);
  max-height: 140rpx;
  overflow: hidden;
  text-align: center;
  word-break: break-all;
  line-height: 1.5;
}

.rec-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted-foreground);
}

.rec-btns {
  display: flex;
  margin-top: 40rpx;
  width: 100%;
  gap: 20rpx;
}

.rec-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  transition: opacity 0.15s ease;
}

.rec-btn:active {
  opacity: 0.8;
}

.rec-btn-cancel {
  background: var(--secondary);
  color: var(--secondary-foreground);
  border: 1rpx solid var(--border);
}

.rec-btn-send {
  background: var(--primary);
  color: var(--primary-foreground);
}
