<view class="page">

  <view class="hero">
    <view class="hero-title">史海对话</view>
    <view class="hero-sub">跨越千年，与先贤对坐倾谈</view>
  </view>

  <view class="section-title">选择一位历史人物</view>

  <view wx:if="{{loading}}" class="tip">正在加载人物…</view>
  <view wx:elif="{{error}}" class="tip error">{{error}}</view>

  <view wx:else class="grid">
    <view
      wx:for="{{characters}}"
      wx:key="id"
      class="card"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
      data-avatar="{{item.avatar}}"
      bindtap="onTapCharacter"
    >
      <image class="avatar" src="/images/avatars/{{item.avatar}}" mode="aspectFill"></image>
      <view class="card-body">
        <view class="card-name">{{item.name}}</view>
        <view class="card-era">{{item.dynasty}} · {{item.title}}</view>
        <view class="card-tagline">“{{item.tagline}}”</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>

  <view class="footer">后端：Spring Boot（Java 21）· 部署：WSL k3s GitOps</view>
</view>
