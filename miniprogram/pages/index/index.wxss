.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx 48rpx;
  background: var(--background);
}

/* ===== Hero：干净留白 + 强排版 ===== */
.hero {
  padding: 88rpx 8rpx 48rpx;
}

.hero-title {
  font-size: 60rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--foreground);
  line-height: 1.2;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: var(--muted-foreground);
  letter-spacing: 1rpx;
  font-weight: 400;
}

/* ===== Section 标签 ===== */
.section-label {
  display: flex;
  align-items: center;
  padding: 8rpx 4rpx 24rpx;
}

.section-label-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted-foreground);
  letter-spacing: 3rpx;
  flex-shrink: 0;
}

.section-label-line {
  flex: 1;
  height: 1rpx;
  background: var(--border);
  margin-left: 20rpx;
}

/* ===== 加载 / 错误态 ===== */
.state {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.state-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: state-spin 0.8s linear infinite;
}

@keyframes state-spin {
  to { transform: rotate(360deg); }
}

.state-text {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: var(--muted-foreground);
}

.state-error-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FEF2F2;
  color: var(--destructive);
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.state-error {
  color: var(--destructive);
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
  word-break: break-all;
}

/* ===== 人物卡片 ===== */
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 26rpx;
  box-shadow: var(--shadow-xs);
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.card-hover {
  background: var(--muted);
  box-shadow: var(--shadow-sm);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-full);
  border: 2rpx solid var(--border);
  flex-shrink: 0;
  background: var(--secondary);
}

.card-body {
  flex: 1;
  margin-left: 26rpx;
  min-width: 0;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--card-foreground);
  letter-spacing: 1rpx;
}

.card-arrow {
  font-size: 44rpx;
  color: var(--muted-foreground);
  opacity: 0.6;
  line-height: 1;
  margin-left: 12rpx;
}

.card-era {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted-foreground);
  font-weight: 500;
}

.card-tagline {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--muted-foreground);
  opacity: 0.8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== Footer ===== */
.footer {
  margin-top: 56rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--muted-foreground);
  opacity: 0.6;
  letter-spacing: 2rpx;
}
